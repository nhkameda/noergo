# noergo — self-hosting configuration. Copy to docker/.env and fill in.
# Generate each secret with:  openssl rand -hex 32
# (hex, so it is safe inside database URLs). Never commit the filled-in file.

# ── Instance
NOERGO_PUBLIC_URL=https://notes.example.com
# Only for the bundled Caddy (`--profile caddy`): the bare domain of NOERGO_PUBLIC_URL.
NOERGO_DOMAIN=notes.example.com
# Image tag. Pin a release (e.g. 0.1.0) in production.
NOERGO_VERSION=latest
# Interface the web and mcp ports bind to on the host. Keep 127.0.0.1 behind a local proxy.
NOERGO_BIND=127.0.0.1
# Host ports of web and mcp. Change them to run a second instance on the same machine.
NOERGO_WEB_PORT=3041
NOERGO_MCP_PORT=3042

# ── Database (used once by the postgres container to create the roles)
POSTGRES_PASSWORD=
NOERGO_DB_MIGRATOR_PASSWORD=
NOERGO_DB_APP_PASSWORD=
NOERGO_DB_JOBS_PASSWORD=

# ── Sign-in. Configure at least one provider.
AUTH_SECRET=
# Your own e-mail: administrators can always sign up, whatever SIGNUP says.
NOERGO_ADMIN_EMAILS=
# Who else may create an account: allowlist (the e-mails or @domains below) or open (anyone).
SIGNUP=allowlist
SIGNUP_ALLOWLIST=
# Google (https://console.cloud.google.com/apis/credentials), redirect URI:
#   ${NOERGO_PUBLIC_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Microsoft Entra ID, redirect URI: ${NOERGO_PUBLIC_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Any OpenID Connect provider (Authentik, Keycloak, Zitadel…), redirect URI:
#   ${NOERGO_PUBLIC_URL}/api/auth/callback/oidc
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=

# ── Billing. off = no plans, everyone gets every feature (including agents over MCP).
BILLING=off

# ── Attachments. local = the "files" volume; s3 = any S3-compatible bucket.
STORAGE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public origin the files are served from (a separate origin, without cookies).
NOERGO_ATTACHMENTS_ORIGIN=
