{
  "name": "noergo",
  "version": "0.1.0",
  "private": true,
  "description": "Noergo — a visual memory for you and your AI agents: boards, mind maps and a knowledge graph, reachable over MCP.",
  "license": "AGPL-3.0-only",
  "homepage": "https://noergo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhkameda/noergo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @noergo/web",
    "dev:mcp": "npm run dev --workspace @noergo/mcp",
    "dev:worker": "npm run dev --workspace @noergo/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e --workspace @noergo/web",
    "secrets": "gitleaks git --redact --no-banner --config .gitleaks.toml",
    "check": "npm run typecheck && npm run lint && npm run test && npm audit --omit=dev --audit-level=high",
    "db:migrate": "npm run db:migrate --workspace @noergo/core",
    "db:deploy": "npm run db:deploy --workspace @noergo/core",
    "db:dev": "sh packages/core/scripts/dev-db.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "oauth2-mock-server": "^9.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
