#!/bin/sh
# Blocks a commit that carries a secret. The repository is public: a leak here is permanent.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found (https://github.com/gitleaks/gitleaks#installing)." >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner --config .gitleaks.toml
